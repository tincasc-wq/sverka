# Шаблон секретов сервера. Скопируйте в C:\Project\sverka\.env.prod (в git не попадает),
# заполните и загрузите: .\deploy\deploy.ps1 env. На сервере файл лежит в ~/sverka/.env.

DOMAIN=ang-rist.ru
PUBLIC_BASE_URL=https://ang-rist.ru

POSTGRES_USER=sverka
POSTGRES_DB=sverka
# Новый длинный пароль, не тот, что локально:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://sverka:ПАРОЛЬ_ИЗ_POSTGRES_PASSWORD@db:5432/sverka
REDIS_URL=redis://redis:6379/0

# Новые значения для сервера (python -c "import secrets; print(secrets.token_hex(32))"):
SECRET_KEY=
ADMIN_TOKEN=

# Тот же бот, что локально. Перед запуском на сервере остановите локального бота —
# два процесса с одним токеном мешают друг другу.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

DEEPSEEK_API_KEY=
QWEN_API_KEY=
YANDEX_AI_STUDIO_API_KEY=
ANTHROPIC_API_KEY=

# Из РФ t.me и DeepSeek доступны напрямую. Шлюз (Казахстан) подключим позже:
# тогда здесь появятся адреса прокси, и заработают 16 источников с via_gateway.
TELEGRAM_PROXY=
COLLECTOR_PROXY=
LLM_PROXY=

FETCH_FULL_TEXT=true
