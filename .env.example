# Скопируйте в .env. Значения ниже годятся только для локальной разработки.
POSTGRES_USER=sverka
POSTGRES_PASSWORD=sverka-dev
POSTGRES_DB=sverka

# Внутри docker compose хост БД — db, Redis — redis.
DATABASE_URL=postgresql+asyncpg://sverka:sverka-dev@db:5432/sverka
TEST_DATABASE_URL=postgresql+asyncpg://sverka:sverka-dev@db:5432/sverka_test
REDIS_URL=redis://redis:6379/0

# Сборщики. TELEGRAM_PROXY локально подставляет .\dev.ps1 up (Hiddify на Windows);
# на сервере, где t.me доступен напрямую, не нужен.
FETCH_FULL_TEXT=true

# Вход в админку http://localhost:8000/admin (временно, до Telegram Login).
ADMIN_TOKEN=

# Сайт: ключ подписи cookie (python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=
# Имя бота без @ для входа через Telegram на сайте; домен сайта — /setdomain у @BotFather.
TELEGRAM_BOT_USERNAME=

# Telegram-бот: токен от @BotFather. Адрес веб-отчётов для ссылок в ответах бота.
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000

# LLM (раздел 8.1 ТЗ): по умолчанию DeepSeek; DeepSeek и Qwen — через шлюз за рубежом.
LLM_PROXY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
YANDEX_AI_STUDIO_API_KEY=
# Запасной вариант, выключен в config/llm.yaml: только при законном доступе к API Anthropic.
ANTHROPIC_API_KEY=
