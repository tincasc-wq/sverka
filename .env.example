# Скопируйте в .env. Значения ниже годятся только для локальной разработки.
POSTGRES_USER=sverka
POSTGRES_PASSWORD=sverka-dev
POSTGRES_DB=sverka

# Внутри docker compose хост БД — db, Redis — redis.
DATABASE_URL=postgresql+asyncpg://sverka:sverka-dev@db:5432/sverka
TEST_DATABASE_URL=postgresql+asyncpg://sverka:sverka-dev@db:5432/sverka_test
REDIS_URL=redis://redis:6379/0

# LLM (понадобятся с этапа 3)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
YANDEX_AI_STUDIO_API_KEY=
